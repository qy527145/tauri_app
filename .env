# ---------------------------------------------------------------------------
# 本地开发默认值，只在 debug 构建里被加载（发给用户的安装包不会读这个文件）。
# 这里只放【非敏感】配置，可以安全提交；密钥请写在 .env.local（已 gitignore）。
# 所有变量都在 .env.example 里有一行说明，新增变量请同步更新那里。
# ---------------------------------------------------------------------------

# 日志过滤："<默认级别>,<target>=<级别>"。日志同时写入 stdout 与系统日志目录。
RUST_LOG=info,{{crate_name}}_lib=debug

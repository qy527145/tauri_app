# Copy to .env and adjust. Only loaded by debug builds; shipped installers
# never read it, so every variable must have a sane default in config.rs.
# Put real secrets in .env.local (gitignored).

# Log filter. "<default level>,<target>=<level>".
# Logs go to stdout and the OS log dir (Windows: %LOCALAPPDATA%\<identifier>\logs).
RUST_LOG=info,{{crate_name}}_lib=debug

# Add project-specific variables below, with one comment line each.

# Self-update ("check for updates" in the app).
# Try GitHub mirrors (gh-proxy.com etc.) when github.com is unreachable; 0 disables.
GITHUB_ACCEL=1
# Explicit proxy, e.g. http://127.0.0.1:7897. Empty = direct (system proxy is ignored).
GITHUB_PROXY=
# Check GitHub Releases once on startup; 0 disables (manual check still works).
AUTO_CHECK_UPDATE=1
